# ─────────────────────────────────────────────────────────────────────────────
# Shuv Marg Super Admin — Environment Variables
#
# Copy this file to .env and fill in values for your environment.
# VITE_* variables are embedded at build time and exposed to the browser.
# Never put secrets (JWT secrets, private keys, etc.) in VITE_ vars.
#
# DO NOT COMMIT .env — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL
# Local:      http://localhost:7012
# Staging:    https://api-staging.shuvmarg.com
# Production: https://api.shuvmarg.com
VITE_API_URL=

# Google Maps JavaScript API key
# Required for the Stop Registry map, Boarding Location map, and Route Discovery map.
# Obtain a key from https://console.cloud.google.com/ with Maps JavaScript API enabled.
# Set this in your Vercel project environment (Production + Preview) — do NOT put the
# real key in this file.
VITE_GOOGLE_MAPS_API_KEY=
